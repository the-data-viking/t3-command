{
  "name": "t3-command",
  "private": true,
  "version": "0.0.0",
  "managedUpdateProtocol": 1,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,ui -c blue,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "node --watch server/index.ts",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "start:managed": "node tools/managed-launcher.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "pair:local": "node tools/pair-local.mjs",
    "test": "tsx --tsconfig tsconfig.app.json --test src/game/*.test.ts src/t3/*.test.ts src/ui/*.test.tsx server/*.test.ts",
    "check:layout": "node tools/layout-check.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
